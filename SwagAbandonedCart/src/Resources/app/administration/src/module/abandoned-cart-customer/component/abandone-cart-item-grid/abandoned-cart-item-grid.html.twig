{% block abandoned_cart_items_grid %}
    <sw-container slot="grid" type="row" class="sw-order-line-items-grid">

        {% block abandoned_cart_items_grid_grid %}
            <sw-data-grid :dataSource="cartLineItems"
                          :columns="getLineItemColumns"
                          :fullPage="false"
                          :showSettings="false"
                          :showSelection="false"
                          :showActions="true"
                          :isLoading="isLoading"
                          :allowColumnEdit="false"
                          :allowInlineEdit="false"
                          :compactMode="true"
                          identifier="sw-order-line-item-grid"
                          class="sw-order-line-items-grid__data-grid">

                {% block abandoned_cart_items_grid_grid_columns %}
                    {% block abandoned_cart_items_grid_grid_columns_label %}
                        <template #column-label="{ item }">
                            {% block abandoned_cart_items_grid_grid_columns_label_link %}
                                <router-link v-if="item.type === 'product'"
                                             :title="$tc('sw-order.detailBase.contextMenuShowProduct')"
                                             :to="{ name: 'sw.product.detail', params: { id: item.referencedId } }">
                                    {% block abandoned_cart_items_grid_columns_name_label %}
                                        <sw-product-variant-info :variations="item.payload.options">
                                            {{ item.label }}
                                        </sw-product-variant-info>
                                    {% endblock %}
                                </router-link>
                            {% endblock %}

                            {% block abandoned_cart_items_grid_grid_columns_label_content %}

                                <template v-else>
                                    <sw-product-variant-info :variations="item.payload.options">
                                        {{ item.label }}
                                    </sw-product-variant-info>
                                </template>
                            {% endblock %}

                        </template>
                    {% endblock %}

                    {% block abandoned_cart_items_grid_grid_columns_unit_price %}
                        <template #column-price.unitPrice="{ item }">
                            {% block abandoned_cart_items_grid_grid_columns_unit_price_content %}
                                {{  currencyFilter(item.price.unitPrice, currency.isoCode) }}
                            {% endblock %}
                        </template>
                    {% endblock %}

                    {% block abandoned_cart_items_grid_grid_columns_quantity %}
                        <template #column-quantity="{ item, isInlineEdit }">
                            {% block abandoned_cart_items_grid_grid_columns_quantity_content %}
                                <template>
                                    {{ item.quantity }}
                                </template>
                            {% endblock %}
                        </template>
                    {% endblock %}

                    {% block abandoned_cart_items_grid_grid_columns_total_price %}
                        <template #column-price.totalPrice="{ item }">
                            {% block abandoned_cart_items_grid_grid_columns_total_price_content %}
                                <template>
                                    {{ currencyFilter(item.price.totalPrice, currency.isoCode) }}
                                </template>
                            {% endblock %}
                        </template>
                    {% endblock %}

                    {% block abandoned_cart_items_grid_grid_columns_tax %}
                        <template #column-price.taxRules[0]="{ item, isInlineEdit }">

                            {% block abandoned_cart_items_grid_grid_columns_tax_content %}
                                <template v-if="item.price && item.price.taxRules.length">
                                    {{ item.price.taxRules[0].taxRate }} %
                                </template>
                            {% endblock %}

                        </template>
                    {% endblock %}

                    {% block abandoned_cart_items_grid_grid_actions %}
                        <template #actions="{ item }">
                            {% block abandoned_cart_items_grid_grid_actions_show %}
                            <sw-context-menu-item :disabled="item.type !== 'product'"
                                                  icon="regular-eye"
                                                  :routerLink="{ name: 'sw.product.detail', params: { id: item.referencedId } }">
                                {% block abandoned_cart_items_grid_grid_actions_show_label %}
                                    {{ $tc('sw-order.detailBase.contextMenuShowProduct') }}
                                {% endblock %}
                            </sw-context-menu-item>
                            {% endblock %}
                        </template>
                    {% endblock %}
                {% endblock %}
            </sw-data-grid>
        {% endblock %}
    </sw-container>
{% endblock %}
