export default "{% block abandoned_cart_notification %}\n    <sw-page class=\"abandoned-cart-list\">\n        {% block wk_abandoned_cart_list_search_bar %}\n            <template #search-bar>\n                <sw-search-bar \n                    :initialSearchType=\"$tc('abandoned-cart-customer.general.headlineAbandonedCart')\"\n                    :initialSearch=\"term\"\n                    @search=\"onSearch\">\n                </sw-search-bar>\n            </template>\n        {% endblock %}\n\n        <template #smart-bar-header>\n            <h2>\n                {% block abandoned_cart_notification_smart_bar_header_title_text %}\n                    {{ $tc('sw-settings.index.title') }}\n                    <sw-icon name=\"regular-chevron-right-s\" small></sw-icon>\n                    {{ $tc('abandoned-cart-customer.general.mainMenuItemGeneral') }}\n                {% endblock %}\n\n                {% block abandoned_cart_notification_smart_bar_header_amount %}\n                    <span v-if=\"!isLoading\" class=\"sw-page__smart-bar-amount\">\n                        ({{ total }})\n                    </span>\n                {% endblock %}\n            </h2>\n        </template>\n\n        {% block abandoned_cart_notification_smart_bar_actions %}\n            <template #smart-bar-actions>\n                {% block abandoned_cart_notification_smart_bar_actions_bulk %}\n                    <sw-button\n                        v-if=\"selectedCount > 0\"\n                        @click=\"onBulkDelete\"\n                        variant=\"danger\"\n                        size=\"small\">\n                        {{ $tc('abandoned-cart-customer.list.bulkDelete') }} ({{ selectedCount }})\n                    </sw-button>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        {% block abandoned_cart_notification_content %}\n            <template #content>\n                {% block abandoned_cart_notification_content_card %}\n                    <sw-card\n                        :isLoading=\"isLoading\"\n                        class=\"abandoned-cart-notification-list\">\n                        \n                        {% block abandoned_cart_notification_content_list %}\n                            <sw-data-grid \n                                identifier=\"cart-notification-list\"\n                                v-if=\"customers && customers.length > 0\"\n                                :isLoading=\"isLoading\"\n                                ref=\"dataGrid\"\n                                :dataSource=\"customers\"\n                                :columns=\"columns\"\n                                :skeletonItemAmount=\"limit\"\n                                :allowInlineEdit=\"false\"\n                                :allowColumnEdit=\"false\"\n                                :showSettings=\"true\"\n                                :showSelection=\"true\"\n                                :compactMode=\"false\"\n                                :selection=\"selection\"\n                                :sortBy=\"sortBy\"\n                                :sortDirection=\"sortDirection\"\n                                :naturalSorting=\"naturalSorting\"\n                                @selection-change=\"onSelectionChange\"\n                                @column-sort=\"onSortColumn\"\n                                class=\"abandoned-cart-notification-grid\">\n\n\n\n                                {% block abandoned_cart_notification_content_name %}\n                                    <template #column-name=\"{ item }\">\n                                        <router-link \n                                            :to=\"{name: 'sw.customer.detail', params: {id: item.customerId}}\"\n                                            class=\"sw-data-grid__cell-content\">\n                                            {{ item.name }}\n                                        </router-link>\n                                    </template>\n                                {% endblock %}\n\n                                {% block abandoned_cart_notification_content_cart_details %}\n                                    <template #column-cartDetails=\"{ item }\">\n                                       <router-link \n                                            :to=\"{name: 'abandoned.cart.customer.detail', params: {customerId: item.customerId}}\"\n                                            class=\"sw-data-grid__cell-content\">\n                                            <sw-icon name=\"regular-eye\" small></sw-icon>\n                                        </router-link>\n                                    </template>\n                                {% endblock %}\n\n                                {% block abandoned_cart_notification_content_date_added %}\n                                    <template #column-dateAdded=\"{ item }\">\n                                        <span v-if=\"item.dateAdded\">{{ item.dateAdded }}</span>\n                                        <span v-else>-</span>\n                                    </template>\n                                {% endblock %}\n\n                                {% block abandoned_cart_notification_content_last_notified %}\n                                    <template #column-lastNotified=\"{ item }\">\n                                        <span v-if=\"item.lastNotified\">{{ item.lastNotified}}</span>\n                                        <span v-else>{{ $tc('abandoned-cart-customer.list.textNeverNotified') }}</span>\n                                    </template>\n                                {% endblock %}\n\n                                {% block abandoned_cart_notification_content_column_action %}\n                                    <template #actions=\"{ item }\">\n                                        <sw-context-menu-item \n                                            :routerLink=\"{name: 'abandoned.cart.customer.detail', params: {customerId: item.customerId}}\"\n                                            icon=\"regular-eye\">\n                                            {{ $tc('abandoned-cart-customer.list.contextMenuDetail') }}\n                                        </sw-context-menu-item>\n                                        \n                                        <sw-context-menu-item \n                                            @click=\"onClickNotify(item.customerId)\" \n                                            icon=\"regular-envelope\"\n                                            variant=\"success\">\n                                            {{ $tc('abandoned-cart-customer.list.contextMenuNotify') }}\n                                        </sw-context-menu-item>\n                                        \n                                        <sw-context-menu-item \n                                            @click=\"onClickDelete(item.customerId)\" \n                                            icon=\"regular-trash\"\n                                            variant=\"danger\">\n                                            {{ $tc('abandoned-cart-customer.list.contextMenuDelete') }}\n                                        </sw-context-menu-item>\n                                    </template>\n                                {% endblock %}\n\n                                {% block abandoned_cart_notification_content_pagination %}\n                                    <template #pagination>\n                                        <sw-pagination \n                                            :page=\"page\"\n                                            :limit=\"limit\"\n                                            :total=\"total\"\n                                            :total-visible=\"7\"\n                                            @page-change=\"onPageChange\">\n                                        </sw-pagination>\n                                    </template>\n                                {% endblock %}\n                            </sw-data-grid>\n                        {% endblock %}\n\n                        \n                    </sw-card>\n                {% endblock %}\n\n                {% block abandoned_cart_notification_content_empty_state %}\n                    <sw-empty-state \n                        v-if=\"!isLoading && (!customers || customers.length === 0)\"\n                        :title=\"$tc('abandoned-cart-customer.list.messageEmpty')\"\n                        icon=\"regular-shopping-cart\"\n                        :subline=\"$tc('abandoned-cart-customer.list.messageEmptySubline')\">\n                    </sw-empty-state>\n                {% endblock %}\n\n                {% block abandoned_cart_notification_bulk_delete_modal %}\n                    <sw-modal\n                        v-if=\"showBulkDeleteModal\"\n                        :title=\"$tc('abandoned-cart-customer.list.bulkDeleteModalTitle')\"\n                        variant=\"small\"\n                        @modal-close=\"onCloseBulkDeleteModal\">\n                        \n                        {% block abandoned_cart_notification_bulk_delete_modal_text %}\n                            <p class=\"sw-abandoned-cart-list__confirm-bulk-delete-text\">\n                                {{ $tc('abandoned-cart-customer.list.bulkDeleteConfirmText', selectedCount, { count: selectedCount }) }}\n                            </p>\n                        {% endblock %}\n\n                        {% block abandoned_cart_notification_bulk_delete_modal_footer %}\n                            <template #modal-footer>\n                                {% block abandoned_cart_notification_bulk_delete_modal_cancel %}\n                                    <sw-button\n                                        size=\"small\"\n                                        @click=\"onCloseBulkDeleteModal\">\n                                        {{ $tc('abandoned-cart-customer.list.buttonCancel') }}\n                                    </sw-button>\n                                {% endblock %}\n\n                               \n                                {% block abandoned_cart_notification_bulk_delete_modal_confirm %}\n                                    <sw-button\n                                        variant=\"danger\"\n                                        size=\"small\"\n                                        @click=\"onConfirmBulkDelete\">\n                                        {{ $tc('abandoned-cart-customer.list.buttonDelete') }}\n                                    </sw-button>\n                                {% endblock %}\n                            </template>\n                        {% endblock %}\n                    </sw-modal>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        {% block abandoned_cart_notification_list_sidebar %}\n            <template #sidebar>\n                <sw-sidebar>\n                    {% block abandoned_cart_notification_list_sidebar_refresh %}\n                        <sw-sidebar-item\n                            icon=\"regular-undo\"\n                            :title=\"$tc('abandoned-cart-customer.list.titleSidebarItemRefresh')\"\n                            @click=\"onRefresh\">\n                        </sw-sidebar-item>\n                    {% endblock %}\n                </sw-sidebar>\n            </template>\n        {% endblock %} \n    </sw-page>\n{% endblock %}\n";