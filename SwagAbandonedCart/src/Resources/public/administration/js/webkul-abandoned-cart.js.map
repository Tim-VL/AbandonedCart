export default "{% block abandoned_cart_items_grid %}\n    <sw-container slot=\"grid\" type=\"row\" class=\"sw-order-line-items-grid\">\n\n        {% block abandoned_cart_items_grid_grid %}\n            <sw-data-grid :dataSource=\"cartLineItems\"\n                          :columns=\"getLineItemColumns\"\n                          :fullPage=\"false\"\n                          :showSettings=\"false\"\n                          :showSelection=\"false\"\n                          :showActions=\"true\"\n                          :isLoading=\"isLoading\"\n                          :allowColumnEdit=\"false\"\n                          :allowInlineEdit=\"false\"\n                          :compactMode=\"true\"\n                          identifier=\"sw-order-line-item-grid\"\n                          class=\"sw-order-line-items-grid__data-grid\">\n\n                {% block abandoned_cart_items_grid_grid_columns %}\n                    {% block abandoned_cart_items_grid_grid_columns_label %}\n                        <template slot=\"column-label\" slot-scope=\"{ item }\">\n                            {% block abandoned_cart_items_grid_grid_columns_label_link %}\n                                <router-link v-if=\"item.type === 'product'\"\n                                             :title=\"$tc('sw-order.detailBase.contextMenuShowProduct')\"\n                                             :to=\"{ name: 'sw.product.detail', params: { id: item.referencedId } }\">\n                                    {% block abandoned_cart_items_grid_columns_name_label %}\n                                        <sw-product-variant-info :variations=\"item.payload.options\">\n                                            {{ item.label }}\n                                        </sw-product-variant-info>\n                                    {% endblock %}\n                                </router-link>\n                            {% endblock %}\n\n                            {% block abandoned_cart_items_grid_grid_columns_label_content %}\n\n                                <template v-else>\n                                    <sw-product-variant-info :variations=\"item.payload.options\">\n                                        {{ item.label }}\n                                    </sw-product-variant-info>\n                                </template>\n                            {% endblock %}\n\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_items_grid_grid_columns_unit_price %}\n                        <template slot=\"column-price.unitPrice\" slot-scope=\"{ item }\">\n                            {% block abandoned_cart_items_grid_grid_columns_unit_price_content %}\n                                {{  item.price.unitPrice | currency(currency.isoCode) }}\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_items_grid_grid_columns_total_price %}\n                        <template slot=\"column-price.totalPrice\" slot-scope=\"{ item }\">\n                            {% block abandoned_cart_items_grid_grid_columns_total_price_content %}\n                                {{  item.price.totalPrice | currency(currency.isoCode) }}\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_items_grid_grid_columns_quantity %}\n                        <template slot=\"column-quantity\" slot-scope=\"{ item, isInlineEdit }\">\n                            {% block abandoned_cart_items_grid_grid_columns_quantity_content %}\n                                <template>\n                                    {{ item.quantity }}\n                                </template>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_items_grid_grid_columns_tax %}\n                        <template slot=\"column-price.taxRules[0]\" slot-scope=\"{ item, isInlineEdit }\">\n\n                            {% block abandoned_cart_items_grid_grid_columns_tax_content %}\n                                <template v-if=\"item.price && item.price.taxRules.length\">\n                                    {{ item.price.taxRules[0].taxRate }} %\n                                </template>\n                            {% endblock %}\n\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_items_grid_grid_actions %}\n                        <template #actions=\"{ item }\">\n                            {% block abandoned_cart_items_grid_grid_actions_show %}\n                            <sw-context-menu-item :disabled=\"item.type !== 'product'\"\n                                                  icon=\"default-eye-open\"\n                                                  :routerLink=\"{ name: 'sw.product.detail', params: { id: item.referencedId } }\">\n                                {% block abandoned_cart_items_grid_grid_actions_show_label %}\n                                    {{ $tc('sw-order.detailBase.contextMenuShowProduct') }}\n                                {% endblock %}\n                            </sw-context-menu-item>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n                {% endblock %}\n            </sw-data-grid>\n        {% endblock %}\n    </sw-container>\n{% endblock %}\n";