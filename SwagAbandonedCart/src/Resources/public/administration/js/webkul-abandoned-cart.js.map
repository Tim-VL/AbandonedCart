export default "{% block abandoned_cart_notification_detail %}\n    <sw-page class=\"abandoned-cart-detail\">\n        {% block abandoned_cart_notification_detail_smart_bar_action %}\n            <template slot=\"smart-bar-actions\">\n                <sw-button :routerLink=\"{ name: 'abandoned.cart.customer.index' }\">\n                    {{ $t('abandoned-cart-customer.detail.cancelButtonText') }}\n                </sw-button>\n                <sw-button-process\n                    :disabled=\"isLoading\"\n                    variant=\"primary\"\n                    :processSuccess=\"processSuccess\"\n                    @click=\"onClickNotify\">\n                    {{ $t('abandoned-cart-customer.detail.notifyButtonText') }}\n                </sw-button-process>\n            </template>\n        {% endblock %}\n        {% block abandoned_cart_notification_detail_content %}\n            <sw-card-view slot=\"content\">\n                <sw-card v-if=\"customer\" :isLoading=\"isLoading\" :title=\"$tc('abandoned-cart-customer.detail.headingTitle')\">\n                    <sw-container columns=\"80px 1fr max-content\"\n                                        gap=\"0px 30px\"\n                                        align=\"center\"\n                                        class=\"sw-order-user-card__container\">\n                        {% block abandoned_cart_notification_detail_user_card_avatar %}\n                            <sw-avatar size=\"80px\"\n                                        :color=\"$route.meta.$module.color\"\n                                        :firstName=\"customer.firstName\"\n                                        :lastName=\"customer.lastName\">\n                            </sw-avatar>\n                        {% endblock %}\n                        {% block abandoned_cart_notification_detail_card_metadata_customer_name %}\n                                <div class=\"sw-order-user-card__metadata-user-name\">\n                                    {{ customer.firstName }} {{ customer.lastName }}\n                                </div>\n                                <sw-description-list>\n                                <template>\n                                    <dl>\n                                        <dt>{{ $tc('abandoned-cart-customer.detail.labelEmail') }}</dt>\n                                        <dd> {{ customer.email }}</dd>\n                                    </dl>\n                                </template>\n                                <template>\n                                    <dl>\n                                        <dt>{{ $tc('abandoned-cart-customer.detail.labelSalesChannel') }}</dt>\n                                        <dd> {{ customer.salesChannel.name }}</dd>\n                                    </dl>\n                                </template>\n                            </sw-description-list>\n                            {% endblock %}\n                    </sw-container>\n                    {% block abandoned_cart_notification_detail_base_line_items_card_rows %}\n                        <sw-container :isLoading=\"isLoading\"\n                                    slot=\"grid\"\n                                    type=\"row\">\n                            {% block abandoned_cart_notification_detail_base_line_items_grid %}\n                                <abandoned-cart-item-grid :cart=\"cart\" :currency=\"currency\" ref=\"sw-order-line-item-grid\"></abandoned-cart-item-grid>\n                            {% endblock %}\n                            \n                            {% block abandoned_cart_notification_detail_base_line_items_summary %}\n                                <sw-card-section divider=\"top\" secondary slim>\n                                    <sw-container columns=\"1fr 440px\"\n                                                class=\"sw-order-detail__summary\">\n                                        <dl class=\"sw-description-list sw-order-detail__summary-data\">\n                                            {% block abandoned_cart_notification_detail_base_line_items_summary_amount %}\n                                                <div class=\"abandoned-row\">\n                                                    <dl>\n                                                        <dt>{{ $tc('sw-order.detailBase.summaryLabelAmount') }}</dt>\n                                                        <dd>{{  cart.price.positionPrice | currency(currency.isoCode) }}</dd>\n                                                    </dl>\n                                                </div>\n                                            {% endblock %}\n\n                                            {% block abandoned_cart_notification_detail_base_line_items_summary_amount_without_tax %}\n                                                <div class=\"abandoned-row\">\n                                                    <dl>\n                                                        <dt><strong>{{ $tc('sw-order.detailBase.summaryLabelAmountWithoutTaxes') }}</strong></dt>\n                                                        <dd><strong>{{  cart.price.netPrice | currency(currency.isoCode) }}</strong></dd>\n                                                    </dl>\n                                                </div>\n                                            {% endblock %}\n\n                                            {% block abandoned_cart_notification_detail_base_line_items_summary_taxes %}\n                                                <template v-for=\"calculatedTax in sortedCalculatedTaxes\">\n                                                    <div class=\"abandoned-row\">\n                                                        <dl>\n                                                            <dt>{{ $tc('sw-order.detailBase.summaryLabelTaxes', 1, { taxRate: calculatedTax.taxRate }) }}</dt>\n                                                            <dd>{{  calculatedTax.tax | currency(currency.isoCode) }}</dd>\n                                                        </dl>\n                                                    </div>\n                                                </template>\n                                            {% endblock %}\n\n                                            {% block abandoned_cart_notification_detail_base_line_items_summary_amount_total %}\n                                                <div class=\"abandoned-row\">\n                                                    <dl>\n                                                        <dt><strong>{{ $tc('sw-order.detailBase.summaryLabelAmountTotal') }}</strong></dt>\n                                                        <dd><strong>{{  cart.price.totalPrice | currency(currency.isoCode) }}</strong></dd>\n                                                    </dl>\n                                                </div>\n                                            {% endblock %}\n                                        </dl>       \n                                    </sw-container>\n                                </sw-card-section>\n                            {% endblock %}\n                        </sw-container>\n                    {% endblock %}\n                </sw-card>\n            </sw-card-view>\n        {% endblock %}\n    </sw-page>\n{% endblock %}";