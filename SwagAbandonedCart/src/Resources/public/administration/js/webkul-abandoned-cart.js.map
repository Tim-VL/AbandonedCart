export default "{% block abandoned_cart_notification %}\n    <sw-page class=\"abandoned-cart-list\">\n        {% block wk_ebay_category_list_search_bar %}\n            <template #search-bar>\n                <sw-search-bar :initialSearchType=\"$tc('abandoned-cart-customer.general.headlineAbandonedCart')\"\n                                :initialSearch=\"term\"\n                                @search=\"onSearch\">\n                </sw-search-bar>\n            </template>\n        {% endblock %}\n            <template #smart-bar-header>\n                <h2>\n                    {% block abandoned_cart_notification_smart_bar_header_title_text %}\n                        {{ $tc('sw-settings.index.title') }}\n                        <sw-icon name=\"regular-chevron-right-s\" small>\n                        </sw-icon>\n                        {{ $tc('abandoned-cart-customer.general.mainMenuItemGeneral') }}\n                    {% endblock %}\n\n                    {% block abandoned_cart_notification_smart_bar_header_amount %}\n                        <span v-if=\"!isLoading\">\n                            ({{ total }})\n                        </span>\n                    {% endblock %}\n                </h2>\n            </template>\n        {% block abandoned_cart_notification_content %}\n            <template slot=\"content\">\n                <sw-data-grid \n                    v-if=\"customers\"\n                    :isLoading=\"isLoading\"\n                    :dataSource=\"customers\"\n                    :columns=\"columns\"\n                    :skeletonItemAmount=\"limit\"\n                    :allowInlineEdit=\"false\"\n                    :allowColumnEdit=\"false\"\n                    :showSettings=\"true\"\n                    :showSelection=\"false\">\n\n                    {% block abandoned_cart_notification_content_name %}\n                        <template #column-name=\"{ item }\">\n                            <sw-context-menu-item :routerLink=\"{name: 'abandoned.cart.customer.detail', params: {customerId: item.customerId}}\">\n                                {{ item.name }}\n                            </sw-context-menu-item>\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_notification_content_last_notified %}\n                        <template #column-lastNotified=\"{ item }\">\n                            <span v-if=\"item.lastNotified\"> {{ item.lastNotified }} </span>\n                            <span v-else> {{ $t('abandoned-cart-customer.list.textNeverNotified') }} </span>\n                        </template>\n                    {% endblock %}\n\n                    {% block abandoned_cart_notification_content_column_action %}\n                        <template slot=\"actions\" slot-scope=\"{ item }\">\n                            {% block abandoned_cart_notification_content_column_action_detail %}\n                                <sw-context-menu-item :routerLink=\"{name: 'abandoned.cart.customer.detail', params: {customerId: item.customerId}}\">\n                                    {{ $t('abandoned-cart-customer.list.contextMenuDetail') }}\n                                </sw-context-menu-item>\n                            {% endblock %}\n                            {% block abandoned_cart_notification_content_column_action_notify %}\n                                <sw-context-menu-item @click=\"onClickNotify(item.customerId)\" variant=\"success\">\n                                    {{ $t('abandoned-cart-customer.list.contextMenuNotify') }}\n                                </sw-context-menu-item>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    <template #pagination>\n                        {% block abandoned_cart_notification_list_grid_pagination %}\n                            <sw-pagination :page=\"page\"\n                                    :limit=\"limit\"\n                                    :total=\"total\"\n                                    :total-visible=\"7\"\n                                    @page-change=\"onPageChange\">\n                            </sw-pagination>\n                        {% endblock %}\n                    </template>\n                </sw-data-grid>\n                {% block abandoned_cart_notification_content_empty_state %}\n                    <sw-empty-state v-if=\"total < 1 && !isLoading\"\n                            :title=\"$tc('abandoned-cart-customer.list.messageEmptyTitle')\"\n                            icon=\"regular-shopping-cart\"\n                            :subline=\"$tc('abandoned-cart-customer.general.mainMenuItemDescription')\">\n                    </sw-empty-state>\n                {% endblock %}\n            </template>\n        {% endblock %}\n        {% block abandoned_cart_notification_list_sidebar %}\n            <sw-sidebar slot=\"sidebar\">\n                {% block abandoned_cart_notification_list_sidebar_refresh %}\n                    <sw-sidebar-item\n                    icon=\"regular-undo\"\n                    :title=\"$tc('abandoned-cart-customer.list.titleSidebarItemRefresh')\"\n                    @click=\"onRefresh\">\n                    </sw-sidebar-item>\n                {% endblock %}\n            </sw-sidebar>\n        {% endblock %} \n    </sw-page>\n{% endblock %}";